GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=reelops-agentic-cinema
GOOGLE_CLOUD_LOCATION=us-central1
GRAFANA_URL=
GRAFANA_MCP_URL=http://localhost:8000/mcp
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# query_prometheus and query_loki_logs both require a datasourceUid. Pinned
# rather than discovered, which would mean enabling the `datasource` category.
# Read them from /connections/datasources/edit/<uid> in Grafana.
GRAFANA_PROM_DATASOURCE_UID=
GRAFANA_TEMPO_DATASOURCE_UID=
GRAFANA_LOKI_DATASOURCE_UID=
FIRESTORE_DATABASE=(default)
ACTION_GATEWAY_URL=http://localhost:8080
SIMULATOR_URL=http://localhost:8090

# Simulator. Sim state is a pure function of SIM_SEED plus injected events,
# so the same seed reproduces a run exactly. SIM_SPEED is sim seconds per real
# second: 60 plays the 14:30-16:00 window in 90 seconds.
SIM_SEED=42
SIM_SPEED=60
SIM_TICK_SECONDS=10
SIM_API_PORT=8090
RENDER_WORKERS=12

# Telemetry export. Off by default; switching it on with no endpoint raises at
# startup rather than exporting into the void. TELEMETRY_CONSOLE prints locally
# instead, which needs no Grafana account.
TELEMETRY_ENABLED=false
TELEMETRY_CONSOLE=false
OTEL_EXPORT_INTERVAL_MS=5000
DEPLOY_ENVIRONMENT=demo
# The `project` label on every exported metric, and the dashboard's $project.
PROJECT_ID=reelops-demo

# The live Grafana MCP gate is opt-in, and fails rather than skips when set with
# incomplete config. Needs mcp-grafana and the simulator both running.
# REELOPS_LIVE_MCP=1

# Copy from your Grafana Cloud stack's OpenTelemetry tile. Secrets: never commit.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=reelops-simulator
