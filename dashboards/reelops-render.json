{
  "title": "ReelOps — Render Capacity",
  "uid": "reelops-render",
  "tags": ["reelops", "render"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": { "uid": "${prom}" },
        "query": "label_values(render_queue_depth, project)",
        "refresh": 1,
        "current": { "text": "reelops-demo", "value": "reelops-demo" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Render queue depth",
      "description": "The first signal to move. Queue growth is a consequence of lost capacity, never written in by the fault injector.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "render_queue_depth{project=\"$project\"}",
          "legendFormat": "queued jobs"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Render workers available",
      "description": "Workers observably able to take work at full rate. Degraded workers are excluded — a worker crawling at a third of its rate is not capacity a scheduler can count on.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 8 },
              { "color": "green", "value": 11 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "render_workers_available{project=\"$project\"}",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Render job duration — p95",
      "description": "render_job_duration_seconds is a histogram, so the bare name carries no series. The p95 is where partial degradation shows; the mean barely moves.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(render_job_duration_seconds_bucket{project=\"$project\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "uid": "${prom}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(render_job_duration_seconds_bucket{project=\"$project\"}[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Render throughput",
      "description": "Frames completed in the trailing 900 sim-seconds, per second of that window.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "render_throughput_fps{project=\"$project\"}",
          "legendFormat": "fps"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Render failures",
      "description": "A counter, so query the rate. Sits flat at zero on a healthy farm.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "rate(render_jobs_failed_total{project=\"$project\"}[5m]) * 60",
          "legendFormat": "failures/min"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Editorial exposure",
      "description": "Scenes whose review cannot start because upstream shots are unfinished, and the longest wait in the review queue. State facts — deadline risk is inferred by ReelOps, never published as a metric.",
      "datasource": { "uid": "${prom}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${prom}" },
          "expr": "editorial_blocked_scenes{project=\"$project\"}",
          "legendFormat": "blocked scenes"
        },
        {
          "refId": "B",
          "datasource": { "uid": "${prom}" },
          "expr": "editorial_review_queue{project=\"$project\"}",
          "legendFormat": "review queue"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Worker timeouts and delivery breaches",
      "description": "The two events that separate a healthy farm from a degraded one. Both sit at zero in a healthy run.",
      "datasource": { "uid": "${loki}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "${loki}" },
          "expr": "{service_name=\"reelops-simulator\"} | event =~ `worker_timeout|render_failed|asset_delivery_delayed`"
        }
      ]
    }
  ]
}
